EXPERTAUTH_PUBLIC_ORIGIN=https://auth.example.test
EXPERTAUTH_CORE_URL=http://core-a:3567
EXPERTAUTH_CORE_API_KEY=REPLACE_WITH_GENERATED_PRIVATE_KEY
NODE_ENV=production
# Optional self-hosted implicit-TLS SMTP. With no SMTP fields, reset APIs are disabled.
# Mount the password file read-only; never put its contents in source or browser env.
# EXPERTAUTH_SMTP_HOST=smtp.example.test
# EXPERTAUTH_SMTP_PORT=465
# EXPERTAUTH_SMTP_USERNAME=expertauth-mail
# EXPERTAUTH_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# EXPERTAUTH_SMTP_FROM_EMAIL=accounts@example.test
# EXPERTAUTH_SMTP_FROM_NAME=ExpertAuth
# For a private CA, mount its certificate and set NODE_EXTRA_CA_CERTS to that file.
# Optional adapted-Core profile. Requires the separately built and tested Core
# atomic-reset extension; there is no fallback if that private API is missing.
# EXPERTAUTH_RESET_POLICY=atomic-v1
# Optional explicit Node adaptation; upstream Node still declares CDI5.4.
# Requires atomic-v1 and Core grace=5 seconds, recent reuse=TOKEN_THEFT.
# Readiness/auth preflight checks the effective Core settings on every request.
# Core must advertise and implement the dedicated guarded refresh/verify routes.
# Other auth operations still require consistently configured replicas.
# See docs/guarded-session-operations.md; other SDK/tenant profiles remain unqualified.
# EXPERTAUTH_SESSION_POLICY=core-cdi56-grace-v1
