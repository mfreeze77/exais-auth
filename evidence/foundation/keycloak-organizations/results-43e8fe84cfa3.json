    {
      "test_id": "KCORG-REFRESH-SCOPE-SUBSTITUTION-001",
      "outcome": "passed",
      "requirements": [
        "IDN-006",
        "SES-003"
      ],
      "note": "Refresh cannot acquire beta context from an alpha-only authorization grant.",
      "observed": {
        "http_status": 200,
        "resulting_organizations": []
      }
    },
    {
      "test_id": "KCORG-RFC7009-TENANT-LOGOUT-001",
      "outcome": "passed",
      "requirements": [
        "SES-005",
        "IDN-004"
      ],
      "note": "Revoking beta's refresh token detaches that client while alpha refresh remains valid in shared realm SSO.",
      "observed": {
        "revoke_http": 200,
        "beta_refresh_http": 400,
        "alpha_refresh_http": 200,
        "beta_error": "invalid_grant"
      }
    },
    {
      "test_id": "KCORG-LEGACY-LOGOUT-SCOPE",
      "outcome": "observed",
      "requirements": [
        "SES-005",
        "IDN-004"
      ],
      "note": "Legacy refresh-token logout invokes realm SSO logout; this operation is not interchangeable with client refresh-token revocation for tenant-local logout.",
      "observed": {
        "logout_http": 204,
        "beta_refresh_http": 400,
        "alpha_refresh_http": 400
      }
    },
    {
      "test_id": "KCORG-MEMBERSHIP-REMOVAL-LOGIN-001",
      "outcome": "passed",
      "requirements": [
