    {
      "test_id": "KCORG-MEMBERSHIP-REMOVAL-REFRESH-001",
      "outcome": "passed",
      "requirements": [
        "IDN-006",
        "SES-003"
      ],
      "note": "Refresh after membership removal must not recreate beta organization authority; alpha chain must survive.",
      "observed": {
        "beta_http": 400,
