      "requirements": [
        "SES-001",
        "IDN-004"
      ],
      "note": "Admin APIs independently enumerate both client attachments to user sessions.",
      "observed": {
        "client_session_counts": {
          "alpha": 1,
          "beta": 1
        }
      }
    },
