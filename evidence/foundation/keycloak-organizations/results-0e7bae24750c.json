      ],
      "note": "Same already-authenticated alpha member receives explicit beta membership denial with no code/token.",
      "observed": {
        "kind": "explicit-membership-denial",
        "http_status": 403
      }
    },
    {
      "test_id": "KCORG-OUTSIDER-001",
      "outcome": "passed",
      "requirements": [
        "IDN-006"
      ],
      "note": "User with valid credentials and zero organization memberships receives explicit denial.",
      "observed": {
        "kind": "explicit-membership-denial"
      }
    },
    {
      "test_id": "KCORG-EXPLICIT-SHARING-001",
      "outcome": "passed",
      "requirements": [
        "IDN-004"
      ],
      "note": "Same user changes from rejected to admitted after explicit beta association; selected organization claims stay distinct.",
      "observed": {
        "alpha_organizations": [
