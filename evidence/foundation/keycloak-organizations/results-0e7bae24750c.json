    {
      "test_id": "KCORG-CLIENT-ORG-POLICY",
      "outcome": "observed",
      "requirements": [
        "IDN-006"
      ],
      "note": "Organization scope is an authorization context, not a fixed client-to-tenant binding; the application must require its declared tenant context.",
